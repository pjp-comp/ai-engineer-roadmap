# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Hugging Face / model caches
.cache/
# project-local model cache (set via HF_HOME in examples/shared.py)
.models/
*.bin
*.safetensors

# Demo artifacts generated when running examples
# examples/**/*.png
# examples/**/*.pdf
examples/**/*.index
examples/phase1/vectors_map.svg
examples/phase1/kitten_vector.txt
# embeddings-101 generated artifacts (regenerated by the step scripts)
examples/embeddings-101/vectors.npy
examples/embeddings-101/chunks.txt
examples/embeddings-101/*.svg
examples/pdf-multi-content-rag/extracted_images/
examples/pdf-multi-content-rag/cache/
# real third-party report kept locally for testing, not redistributed
examples/pdf-multi-content-rag/Q226+Mgt+Report.pdf
# user's own files dropped into assets/ — ignore the contents, keep the folder
examples/pdf-multi-content-rag/assets/*
!examples/pdf-multi-content-rag/assets/.gitkeep

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
